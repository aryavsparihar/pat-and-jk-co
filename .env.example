# ─── Required ───────────────────────────────────────────────────────────
# Postgres connection string (Neon in production: use the pooled connection string)
DATABASE_URL=postgres://user:password@127.0.0.1:5432/pjk_dev

# The database owner, used only to run migrations at build time. Leave empty locally (DATABASE_URL
# is the owner there). In Vercel, DATABASE_URL is the least-privileged app role and this is the
# owner: see docs/SETUP.md, "Database roles". Setting it switches on the boot check that refuses
# to start the site as the owner.
DATABASE_URL_MIGRATE=
# Previews only: run migrations on a preview deploy (set once Preview has its own Neon branch)
MIGRATE_ON_PREVIEW=

# Long random strings — generate each with: openssl rand -hex 32
PAYLOAD_SECRET=
PREVIEW_SECRET=
CRON_SECRET=

# Signs member (artist and partner) session cookies. Required in production; locally it is derived
# from PAYLOAD_SECRET if left empty. Generate with: openssl rand -base64 32
MEMBER_SESSION_SECRET=

# Public URL of the site, no trailing slash (http://localhost:3000 locally, https://pjk.co.in in production)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Brands ─────────────────────────────────────────────────────────────
# Brand served when the hostname doesn't match any brand's domains (localhost, preview URLs)
DEFAULT_TENANT_SLUG=pjk
# Extra origins allowed to use the admin/API with cookies, comma-separated (e.g. other brand domains)
ALLOWED_ORIGINS=
# The only domain staff accounts may use. Defaults to pjk.co.in; set only to change it
ADMIN_EMAIL_DOMAIN=

# ─── Email (Resend) ─────────────────────────────────────────────────────
# Without a key, emails are printed to the console instead of being sent
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@pjk.co.in
EMAIL_FROM_NAME=PAT and J.K. Co.
# Inbox that receives form notifications (used by the seed script)
CONTACT_INBOX=hello@pjk.co.in
# Shown on the contact page and in the footer (used by the seed script)
BUSINESS_INBOX=business@pjk.co.in
TECHNICAL_INBOX=tech@pjk.co.in

# ─── Cloudflare Turnstile (docs/SECURITY.md) ────────────────────────────
# Both or neither. Leave empty locally: the check is skipped. Previews use Cloudflare's test keys
# (1x00000000000000000000AA and 1x0000000000000000000000000000000AA); production its real ones.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Google Maps (docs/SETUP.md, "Google Maps") ─────────────────────────
# Optional. The map on the artist application's address step: with a key, Google's map with
# address search; without, OpenStreetMap's. The map ID is Google's, for its draggable pin
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ─── Logging ─────────────────────────────────────────────────────────────
# trace, debug, info (the default), warn or error. DISABLE_LOGGING=true silences the logger (tests)
LOG_LEVEL=
DISABLE_LOGGING=

# ─── Local development only ─────────────────────────────────────────────
# DEV_APPLICATIONS_OPEN=1 opens applications on this machine without the shared switch; ignored in
# any production build
DEV_APPLICATIONS_OPEN=

# ─── Media storage (Vercel Blob) ────────────────────────────────────────
# Set automatically when you connect a Blob store in Vercel. Leave empty locally.
BLOB_READ_WRITE_TOKEN=
# Set by Vercel with the public media store; read only to keep KYC out of it
BLOB_STORE_ID=

# ─── Moving files to an S3-compatible store (Cloudflare R2, Backblaze B2) ──
# Leave all of these empty to keep Vercel Blob. docs/COSTS.md, "Moving media to Cloudflare R2",
# has the steps; set MEDIA_STORAGE=s3 only after the copy script has run.
MEDIA_STORAGE=
PRIVATE_STORAGE=
# R2: https://<account id>.r2.cloudflarestorage.com, region auto
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=
S3_PRIVATE_BUCKET=

# ─── KYC: identity and bank details (docs/KYC.md) ───────────────────────
# Leave empty locally: development derives throwaway keys from PAYLOAD_SECRET.
# Required in production; previews need their own keys to use the KYC step.
# Generate each with: openssl rand -base64 32  (two different keys)
# Keep an offline copy of KYC_ENCRYPTION_KEY: without it every KYC record is lost.
KYC_ENCRYPTION_KEY=
KYC_BLIND_INDEX_KEY=
# Only while rotating the encryption key (pnpm kyc:rotate-key): the old key
KYC_ENCRYPTION_KEY_PREVIOUS=
# The private Blob store for identity documents (pjk-kyc), set by Vercel when the store is
# connected. It is reached with the deployment's OIDC token; there is no token to set.
# Leave empty locally: documents are then kept, encrypted, in .uploads/kyc.
KYC_STORE_ID=
