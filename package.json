{
  "name": "pjk-website",
  "version": "1.0.0",
  "description": "PAT and J.K. Co. — group website and multi-brand CMS",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "vercel-build": "node scripts/vercel-build.mjs",
    "brand:trace": "node scripts/brand/trace-logo.mjs",
    "brand:icons": "node scripts/brand/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "brand:embed": "node scripts/brand/embed-svgs.mjs",
    "seed:reset": "cross-env SEED_RESET=1 NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "create-admin": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/create-admin.ts",
    "brand:portraits": "node scripts/brand/make-portraits.mjs",
    "gate-token": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/gate-token.ts",
    "check-email": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/check-email.ts",
    "refresh-portraits": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/refresh-portraits.ts",
    "attach-venture-logo": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/attach-venture-logo.ts"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.89.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/email-resend": "3.89.0",
    "@payloadcms/live-preview-react": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/plugin-form-builder": "3.89.0",
    "@payloadcms/plugin-multi-tenant": "3.89.0",
    "@payloadcms/plugin-redirects": "3.89.0",
    "@payloadcms/plugin-seo": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-vercel-blob": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "clsx": "2.1.1",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "graphql": "16.14.2",
    "lucide-react": "0.563.0",
    "next": "16.3.8",
    "payload": "3.89.0",
    "pino": "9.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "1.0.4",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "28.0.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10"
  },
  "private": true,
  "packageManager": "pnpm@12.4.1"
}
